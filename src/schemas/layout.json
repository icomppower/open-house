{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-house/layout",
  "title": "layout.json — rooms as rectangles in metres, levels, openings, cameras, furniture from the catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["units", "footprint", "levels", "rooms", "openings", "adjacency", "cameras", "furniture", "environment"],
  "$defs": {
    "material": {
      "type": "string",
      "enum": ["walnut", "white_oak", "terrazzo", "board_concrete", "marble_viola", "marble_white", "plaster", "limestone", "redwood_deck", "tile_white", "carpet_wool", "painted_brick", "cladding_dark"]
    },
    "furnitureKey": {
      "type": "string",
      "enum": ["sofa_l", "sofa_straight", "lounge_chair", "ottoman", "coffee_table_plinth", "dining_table", "dining_chair", "island_waterfall", "counter_run", "bar_stool", "bed_king", "bed_queen", "nightstand", "bench", "credenza", "bookshelf_wall", "fireplace_concrete", "tub_freestanding", "vanity_double", "desk", "rug", "plant_tree", "plant_small", "pendant_globe", "floor_lamp", "table_lamp"]
    },
    "environment": {
      "type": "string",
      "enum": ["bay_view", "city_view", "garden", "forest", "neutral_sky"]
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z", "w", "d"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wall": { "type": "string", "enum": ["n", "s", "e", "w"] }
  },
  "properties": {
    "units": { "type": "string", "const": "metres" },
    "footprint": { "$ref": "#/$defs/rect" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "elevation", "height"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "maxLength": 40 },
          "elevation": { "type": "number" },
          "height": { "type": "number", "minimum": 2, "maximum": 6 }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "level", "rect", "floor", "walls"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "level": { "type": "string" },
          "rect": { "$ref": "#/$defs/rect" },
          "floor": { "$ref": "#/$defs/material" },
          "walls": { "$ref": "#/$defs/material" },
          "ceiling": { "$ref": "#/$defs/material" },
          "ceilingHeight": { "type": "number", "minimum": 2, "maximum": 6 }
        }
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "room", "item", "x", "z", "rotation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "room": { "type": "string" },
          "item": { "$ref": "#/$defs/furnitureKey" },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "rotation": { "type": "number", "minimum": 0, "maximum": 360 },
          "material": { "$ref": "#/$defs/material" }
        }
      }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "between", "wall", "offset", "width", "height", "sill"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["door", "opening", "window", "glass_wall", "stair"] },
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "wall": { "$ref": "#/$defs/wall" },
          "offset": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "sill": { "type": "number", "minimum": 0 },
          "mullions": { "type": "integer", "minimum": 0, "maximum": 12 }
        }
      }
    },
    "adjacency": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["photoId", "room", "position", "lookAt", "fov"],
        "properties": {
          "photoId": { "type": "string", "minLength": 1 },
          "room": { "type": "string" },
          "position": { "$ref": "#/$defs/vec3" },
          "lookAt": { "$ref": "#/$defs/vec3" },
          "fov": { "type": "number", "minimum": 40, "maximum": 100 }
        }
      }
    },
    "sun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azimuth", "elevation"],
      "properties": {
        "azimuth": { "type": "number", "minimum": 0, "maximum": 360 },
        "elevation": { "type": "number", "minimum": 1, "maximum": 90 }
      }
    },
    "notes": { "type": "string", "maxLength": 600 }
  }
}
