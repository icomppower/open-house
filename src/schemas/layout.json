{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-house/layout",
  "title": "layout.json — rooms as rectangles in metres, levels, openings, cameras",
  "type": "object",
  "additionalProperties": false,
  "required": ["units", "footprint", "levels", "rooms", "openings", "adjacency", "cameras"],
  "$defs": {
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z", "w", "d"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "wall": { "type": "string", "enum": ["n", "s", "e", "w"] }
  },
  "properties": {
    "units": { "type": "string", "const": "metres" },
    "footprint": { "$ref": "#/$defs/rect" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "elevation", "height"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "maxLength": 40 },
          "elevation": { "type": "number" },
          "height": { "type": "number", "minimum": 2, "maximum": 6 }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "level", "rect", "floor", "walls"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "level": { "type": "string" },
          "rect": { "$ref": "#/$defs/rect" },
          "floor": { "type": "string" },
          "walls": { "type": "string" },
          "ceilingHeight": { "type": "number", "minimum": 2, "maximum": 6 }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "between", "wall", "offset", "width", "height", "sill"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["door", "opening", "window", "glass_wall", "stair"] },
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "wall": { "$ref": "#/$defs/wall" },
          "offset": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "sill": { "type": "number", "minimum": 0 },
          "mullions": { "type": "integer", "minimum": 0, "maximum": 12 }
        }
      }
    },
    "adjacency": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["photoId", "room", "position", "lookAt", "fov"],
        "properties": {
          "photoId": { "type": "string", "minLength": 1 },
          "room": { "type": "string" },
          "position": { "$ref": "#/$defs/vec3" },
          "lookAt": { "$ref": "#/$defs/vec3" },
          "fov": { "type": "number", "minimum": 40, "maximum": 100 }
        }
      }
    },
    "sun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azimuth", "elevation"],
      "properties": {
        "azimuth": { "type": "number", "minimum": 0, "maximum": 360 },
        "elevation": { "type": "number", "minimum": 1, "maximum": 90 }
      }
    },
    "notes": { "type": "string", "maxLength": 600 }
  }
}
